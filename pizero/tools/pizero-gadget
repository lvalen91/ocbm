#!/bin/sh
# pizero-gadget — the configfs composite USB gadget on the Pi Zero 2 W's single dwc2 OTG port.
#
# Target set is ADB + OCBM. Until OCBM exists the config is ADB + NCM + ACM = 8 endpoints, which is
# the shape measured to bind on this board (see pizero/README.md); nothing is dropped early.
#
#   ffs.adb   2 eps   management: shell, push/pull, forward — and it survives UDC rebinds, which
#                     NCM and ACM do not, and which OCBM bring-up will cause on every iteration
#   ncm.usb0  3 eps   a real IP link: outbound CARPLAY_MFI_ADDR, scp, port-forwards
#   acm.gs0   3 eps   console of last resort while the GPIO UART is unwired
#
# WHY THIS IS SPLIT INTO setup/activate RATHER THAN ONE start
# -----------------------------------------------------------
# functionfs imposes an ordering rule: a gadget carrying an ffs function CANNOT bind to the UDC
# until the userspace daemon behind that function has written its descriptors to ep0. So:
#
#     setup     create the gadget, mount functionfs, DO NOT touch UDC
#     (adbd)    systemd starts it; it opens /dev/usb-ffs/adb/ep0 and writes descriptors
#     activate  write UDC -> everything enumerates at once
#
# adbd.service drives all three via a drop-in, replacing Debian's own adbd-usb-gadget helper, which
# builds a competing gadget named `g1` and then fails with EIO on `echo <udc> > UDC` because this
# board has exactly one controller and we already own it.
#
# activate() falls back to binding WITHOUT ffs.adb if the full bind fails. A broken adbd must not
# cost the link — on a board whose only other channels are the same gadget, that would be fatal.
set -e

G=/sys/kernel/config/usb_gadget/pizero
FFS_ADB=/dev/usb-ffs/adb          # hardcoded in adbd; not ours to choose
IFACE_IP=${PIZERO_IP:-192.168.51.2}
IFACE_CIDR=${PIZERO_CIDR:-24}
DEV_MAC=${PIZERO_DEV_MAC:-02:51:00:00:00:02}
HOST_MAC=${PIZERO_HOST_MAC:-02:51:00:00:00:01}
ADBD_BIN=/usr/lib/android-sdk/platform-tools/adbd

log() { echo "[pizero-gadget] $*"; }
udc() { ls /sys/class/udc 2>/dev/null | head -1; }
want_adb() {
    [ "${PIZERO_ADB:-auto}" = "0" ] && return 1
    [ -x "$ADBD_BIN" ]
}

setup() {
    for m in g_ether g_ncm g_serial g_cdc; do
        lsmod 2>/dev/null | grep -q "^$m " && { log "unloading legacy gadget $m"; rmmod "$m"; }
    done
    modprobe libcomposite 2>/dev/null || true
    mountpoint -q /sys/kernel/config || mount -t configfs none /sys/kernel/config
    [ -n "$(udc)" ] || { log "FATAL: no UDC — config.txt needs dtoverlay=dwc2,dr_mode=peripheral"; exit 1; }

    if [ -d "$G" ]; then log "gadget already set up"; else
        mkdir -p "$G"
        echo 0x1d6b > "$G/idVendor"
        echo 0x0104 > "$G/idProduct"
        echo 0x0200 > "$G/bcdUSB"
        echo 0x0100 > "$G/bcdDevice"
        echo 0xEF   > "$G/bDeviceClass"     # IAD, or macOS binds only the first interface
        echo 0x02   > "$G/bDeviceSubClass"
        echo 0x01   > "$G/bDeviceProtocol"
        mkdir -p "$G/strings/0x409"
        echo "carlink"                   > "$G/strings/0x409/manufacturer"
        echo "Pi Zero 2 W OCBM bring-up" > "$G/strings/0x409/product"
        SER=$(sed -n 's/^Serial\s*:\s*//p' /proc/cpuinfo | head -1)
        echo "${SER:-0000000000000000}"  > "$G/strings/0x409/serialnumber"
        mkdir -p "$G/configs/c.1/strings/0x409"
        echo "ADB + NCM + ACM" > "$G/configs/c.1/strings/0x409/configuration"
        echo 250               > "$G/configs/c.1/MaxPower"
    fi

    # --- ffs.adb. The instance name after the dot is what `mount -t functionfs <name>` binds to.
    if want_adb && [ ! -d "$G/functions/ffs.adb" ]; then
        mkdir -p "$G/functions/ffs.adb"
        ln -sf "$G/functions/ffs.adb" "$G/configs/c.1/"
        mkdir -p "$FFS_ADB"
        mountpoint -q "$FFS_ADB" || mount -t functionfs adb "$FFS_ADB"
        log "ffs.adb created, functionfs mounted at $FFS_ADB"
    fi

    # --- NCM, ECM fallback. Which one took is worth logging: it is a different driver on the host.
    if [ ! -d "$G/functions/ncm.usb0" ] && [ ! -d "$G/functions/ecm.usb0" ]; then
        NET=""
        for f in ncm.usb0 ecm.usb0; do mkdir -p "$G/functions/$f" 2>/dev/null && { NET=$f; break; }; done
        [ -n "$NET" ] || { log "FATAL: kernel has neither usb_f_ncm nor usb_f_ecm"; exit 1; }
        echo "$DEV_MAC"  > "$G/functions/$NET/dev_addr"
        echo "$HOST_MAC" > "$G/functions/$NET/host_addr"
        ln -sf "$G/functions/$NET" "$G/configs/c.1/"
        log "net function: $NET"
    fi

    if [ "${PIZERO_ACM:-1}" = "1" ] && [ ! -d "$G/functions/acm.gs0" ]; then
        mkdir -p "$G/functions/acm.gs0" 2>/dev/null \
            && ln -sf "$G/functions/acm.gs0" "$G/configs/c.1/" \
            || log "WARN: no usb_f_acm — no USB serial console"
    fi
    log "setup complete: $(ls "$G/configs/c.1/" | grep '\.' | tr '\n' ' ')"
}

activate() {
    U=$(udc)
    [ -n "$U" ] || { log "FATAL: no UDC"; exit 1; }
    if [ -n "$(cat "$G/UDC" 2>/dev/null)" ]; then log "already bound"; ip_up; return 0; fi

    if echo "$U" > "$G/UDC" 2>/dev/null; then
        log "bound to $U with: $(ls "$G/configs/c.1/" | grep '\.' | tr '\n' ' ')"
    else
        # Almost always adbd not having written its ep0 descriptors. Do not let that cost the link.
        log "WARN: bind failed with ffs.adb present — retrying without it"
        rm -f "$G/configs/c.1/ffs.adb"
        echo "$U" > "$G/UDC" || { log "FATAL: bind failed even without ffs.adb"; exit 1; }
        log "bound to $U WITHOUT adb — check: journalctl -u adbd"
    fi
    ip_up
}

ip_up() {
    i=0; while [ $i -lt 50 ] && [ ! -e /sys/class/net/usb0 ]; do sleep 0.1; i=$((i+1)); done
    if [ -e /sys/class/net/usb0 ]; then
        ip addr replace "$IFACE_IP/$IFACE_CIDR" dev usb0
        ip link set usb0 up
        log "usb0 up at $IFACE_IP/$IFACE_CIDR"
    else
        log "WARN: usb0 never appeared"
    fi
}

deactivate() { echo "" > "$G/UDC" 2>/dev/null || true; log "unbound"; }

stop() {
    [ -d "$G" ] || return 0
    deactivate
    for l in "$G"/configs/c.1/*.*; do [ -L "$l" ] && rm -f "$l"; done
    mountpoint -q "$FFS_ADB" && umount "$FFS_ADB"
    rmdir "$FFS_ADB" 2>/dev/null || true
    rmdir "$G"/configs/c.1/strings/0x409 "$G"/configs/c.1 2>/dev/null || true
    for d in "$G"/functions/*.*; do [ -d "$d" ] && rmdir "$d"; done
    rmdir "$G/strings/0x409" "$G" 2>/dev/null || true
    log "torn down"
}

case "${1:-start}" in
    setup)      setup ;;
    activate)   activate ;;
    deactivate) deactivate ;;
    start)      setup; activate ;;
    stop)       stop ;;
    restart)    stop; setup; activate ;;
    status)
        echo "udc:      $(udc)"
        echo "state:    $(cat /sys/class/udc/*/state 2>/dev/null)"
        echo "bound:    $(cat "$G/UDC" 2>/dev/null || echo '-')"
        echo "config:   $(ls "$G/configs/c.1/" 2>/dev/null | grep '\.' | tr '\n' ' ')"
        echo "usb0:     $(ip -br addr show usb0 2>/dev/null || echo absent)"
        echo "ttyGS0:   $([ -e /dev/ttyGS0 ] && echo present || echo absent)"
        echo "ffs.adb:  $(mountpoint -q $FFS_ADB && echo mounted || echo 'not mounted')"
        echo "adbd:     $(systemctl is-active adbd 2>/dev/null)"
        ;;
    *) echo "usage: $0 {setup|activate|deactivate|start|stop|restart|status}" >&2; exit 2 ;;
esac
