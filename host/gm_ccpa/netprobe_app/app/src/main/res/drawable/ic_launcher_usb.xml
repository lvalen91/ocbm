<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher glyph: the USB trident, drawn as an OUTLINE to match the GM HomeScreen's own tiles
  (Audio, Cameras, Climate, Settings, Wi-Fi Hotspot), which are flat grey wireframe line glyphs with
  no fill and no background. Colour #919191 is sampled from those glyphs on gminfo37.

  The path is the trident from a USB logo SVG (viewBox 0 0 192.756 192.756; its white background
  rect is dropped). The group scales it to ~64 of the 72 viewport units, centred, so the glyph is
  about as tall as the OEM ones (~86 px vs ~80 px, measured on screen). strokeWidth is in PATH
  units and is multiplied by the group scale: 5.0 * 0.3657 = 1.8 viewport units, about 2 px on screen. The OEM
  lines are ~3 px, but a 3 px stroke fills in the gap between the two outlines of the trident's stem.

  Deliberately a PLAIN drawable, NOT an <adaptive-icon> (device-proven 2026-10-15). An adaptive icon
  with a transparent background rendered as a BLACK DISC on the HomeScreen tile:
  AdaptiveIconDrawable.draw() paints its layer bitmap with drawColor(Color.BLACK) before compositing
  the layers (API 32 source, line 361), so its background can never be see-through. HomeScreen
  draws this plain vector as-is: no mask, no tint, no backing shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="72"
    android:viewportHeight="72">
    <group
        android:scaleX="0.3657"
        android:scaleY="0.3657"
        android:translateX="1.55"
        android:translateY="0.90">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FF919191"
            android:strokeWidth="5.0"
            android:strokeLineJoin="round"
            android:strokeLineCap="round"
