<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===================================================================================
         CarPlay projection system app for AAOS on the Raspberry Pi 4.

         Design: pi/docs/01_PROJECTION_APP_DESIGN.md
         Stack underneath: pi/docs/00_PI_AAOS_PORT.md

         This is a PRIVILEGED app. The android.car.permission.* and MANAGE_ACTIVITY_TASKS
         permissions below are signature|privileged and are NOT granted by declaring them
         here — they need the allowlist in privapp-permissions-com.carlink.projection.xml
         installed to /system/etc/permissions and the APK in /system/priv-app. See
         pi/tools/install_projection_app.sh.

         Without the allowlist the app still installs and runs: the AAOS integration
         degrades (no projection status, no steering-wheel keys) and everything on the
         localhost seams keeps working. CarProjectionBridge is written to survive exactly
         that, so a plain `adb install` is a usable debug configuration.
         =================================================================================== -->

    <!-- Ordinary permissions  -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Mic uplink. Without RECORD_AUDIO iOS negotiates the voice uplink and hears silence, which
         is indistinguishable from every other failure in that chain — MicUplink logs the denial
         explicitly for that reason.

         FOREGROUND_SERVICE_MICROPHONE is what lets capture continue once the driver navigates away
         from projection: on Android 11+ a backgrounded app capturing without a microphone-typed FGS
         gets zeroed frames with NO error, so a call would go one-way the moment the user opened
         another app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- INTERNET is required even though every socket is loopback: Android's network
         sandbox gates socket() itself, not the destination address. Without it the seam
         listeners fail to bind with EACCES and there is no video, which reads exactly
         like a protocol failure three layers down. -->

    <!-- Privileged permissions  -->

    <!-- The projection framework. CAR_PROJECTION is what updateProjectionStatus and
         addKeyEventHandler check. -->
    <uses-permission android:name="android.car.permission.CAR_PROJECTION"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.car.permission.ACCESS_CAR_PROJECTION_STATUS"
        tools:ignore="ProtectedPermissions" />

    <!-- Drive state, for limitedUI. -->
    <uses-permission android:name="android.car.permission.CAR_UX_RESTRICTIONS_CONFIGURATION"
        tools:ignore="ProtectedPermissions" />

    <!-- "Return to CarPlay" via moveTaskToFront — GM's own mechanism (GMCarPlay holds both).
         LaunchTileActivity degrades to FLAG_ACTIVITY_REORDER_TO_FRONT without them. -->
    <uses-permission android:name="android.permission.REAL_GET_TASKS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MANAGE_ACTIVITY_TASKS"
        tools:ignore="ProtectedPermissions" />

    <!-- Audio routing/ducking for the voice and media sinks. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING"
        tools:ignore="ProtectedPermissions" />

    <!-- Automotive only. required=true is correct here, unlike :app: this module targets one
         known AAOS build and every entry point assumes car_service exists. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Projection"
        tools:targetApi="36">

        <!-- NO <uses-library android:name="android.car">.

             On this AAOS build android.car is a BOOT CLASSPATH jar, not a declared shared library:
             `pm list libraries` has no android.car entry, while $BOOTCLASSPATH contains
             /system/framework/android.car.jar. So its classes are already on every app's classpath
             and the tag buys nothing — but with required="true" the platform refuses to install
             ("requires unavailable shared library android.car"), and with required="false" it is
             simply a no-op. Either way it is wrong here.

             The compile-time side is separate and still needed: `useLibrary("android.car")` in
             build.gradle.kts puts the public stubs on the COMPILE classpath, and car-system-stubs
             supplies the @SystemApi members the public stub omits. -->

        <!-- The projection surface.

             singleTask is load-bearing, not a preference: it is what guarantees ONE projection
             task exists, which is the precondition for "bring it forward" meaning anything.
             With the default launchMode the tile would create a second instance and the first
             session would be orphaned behind it.

             excludeFromRecents + noHistory are deliberately NOT set — the task must persist in
             recents precisely so it can be returned to.

             NOT exported: it is reached from our own tile, our own notification, and the
             service. Nothing outside should be able to push a surface in front of the driver.

             configChanges is broad because a MediaCodec bound to a Surface must not be torn
             down for a UI-mode or density change; surfaceChanged handles the cases that
             genuinely invalidate the Surface. -->
        <activity
            android:name=".ProjectionActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:hardwareAccelerated="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:theme="@style/Theme.Projection.Fullscreen">
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- The launcher tile. This, not ProjectionActivity, is what the home screen points
             at — it decides between "bring projection forward" and "open the device list"
             so that one icon is correct in both states. -->
        <activity
            android:name=".LaunchTileActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Projection.Trampoline">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Automotive launchers filter on CAR_MODE rather than LAUNCHER. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_MODE" />
            </intent-filter>
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- Device management. Exported and carrying the Settings-injection metadata so it
             can appear inside AAOS Settings alongside Bluetooth and Wi-Fi (§7.3) rather than
             only as a standalone screen.

             The injection is the "injected Settings entry" route from §6.3, chosen over a
             Settings overlay because no ROM rebuild is available. -->
        <activity
            android:name=".DeviceManagerActivity"
            android:exported="true"
            android:label="@string/projection_settings_title"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Projection">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.connected" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/projection_settings_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/projection_settings_summary" />
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <!-- The session owner. Not exported: only our own components bind it. -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|mediaPlayback|microphone" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <meta-data
            android:name="com.android.automotive"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="com.android.automotive.application.DISTRACTION_OPTIMIZED"
            android:value="true" />

    </application>

</manifest>
