<?xml version="1.0" encoding="utf-8"?>
<!--
  Catch-all, ON PURPOSE. The AOSP car-usb-handler is the handler for EVERY USB host device (that is
  why config_UsbDeviceConnectionHandling_component points at it), so a broad filter mirrors it.

  On the target GM unit this resource barely matters: the framework launches us by explicit
  component from the fixed-handler path, not by matching this filter. It matters only on the
  fallback (non-broken-unit) resolver path, where matching everything reproduces AOSP behaviour.

  We do NOT narrow this to 0x1314:0x2d00 here: the squat's grant is issued for whatever device
  attaches regardless of this file, and matching everything lets the proof also LOG a C2Air (or any
  other adapter) the first time it is plugged in — the fixed handler sees every device, so this is
  how we discover an adapter's VID/PID without knowing it in advance. UsbGrantProbe does the real
  CCPA-vs-other classification in code.
-->
<resources>
    <usb-device />
</resources>
